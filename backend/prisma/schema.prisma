generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model EventLog {
  id             String   @id @default(uuid())
  aggregateId    String   // ID pesanan yang menjadi subjek kejadian ini
  eventType      String   // Contoh: "OrderCreated", "PaymentProcessing", dll.
  payload        Json     // Menyimpan data tambahan (termasuk nilai Decimal sebagai string)
  version        Int      // Dokumen menanyakan mengapa version menggunakan integer
  timestamp      DateTime @default(now())
  idempotencyKey String   @unique // Wajib unik untuk mencegah pemrosesan ganda

  @@unique([aggregateId, version]) // Constraint: Kombinasi aggregateId dan version harus unik
  @@index([aggregateId, version])  // Index sesuai permintaan dokumen
  @@index([eventType])             // Index sesuai permintaan dokumen
  @@index([timestamp])             // Index sesuai permintaan dokumen
  
  @@map("event_logs") // Nama tabel di database
}

model Ledger {
  id        String   @id @default(uuid())
  orderId   String   // Foreign key bayangan ke pesanan
  account   String   // Contoh: "order_balance", "payment", "fees", "payout"
  debit     Decimal? @db.Decimal(18, 4) // Presisi sangat ketat sesuai permintaan
  credit    Decimal? @db.Decimal(18, 4) // Presisi sangat ketat sesuai permintaan
  timestamp DateTime @default(now())

  @@map("ledgers") // Nama tabel di database
}